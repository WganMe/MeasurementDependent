# ---- build outputs (regenerated by the build, not worth tracking) ----
*.aux
*.bbl
*.blg
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.lof
*.lot

# ---- python ----
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
venv/

# ---- editor / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json

# ---- bulk data deliberately NOT archived ----
# The 55 GB journal-PDF corpus downloaded for the genre-convention measurement was
# deleted; it was third-party publisher PDFs, not ours to redistribute. The guard
# stays so a re-download cannot be committed by accident.
symmetry_corpus/
nuo_fulltext/
MDPI_template_APA.zip

# ---- large or transient artefacts ----
*.zip
delivery/
*_bundle/

# ---- working documents: kept locally, not part of the published record ----
local_only/
*.notes.md
message_to_wael.md
handling_issues_in_unpublished_papers.md

# ---- correspondence stays out of the published record ----
# Review letters and editorial drafts live in admin/ and are ignored here so the
# repository stays a code-and-results record. They are added only if the reviews
# become public.
admin/review/
admin/editorial/

# ---- build logs other than the one build.sh writes ----
build*.log
p[0-9]*.log
r[0-9]*.log

# ---- reorganisation helper ----
_reorganise.sh

# correspondence, deposit notes and editorial drafts: local only
admin/
